# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# 접속 주소. 내 도메인이면 www도 함께 적는다(www로 들어오면 www 없는 주소로 넘긴다).
# 도메인이 없으면 서버 공인 IP의 점을 하이픈으로 바꾼 sslip.io 주소(예: 158.180.1.2 → 158-180-1-2.sslip.io).
SITE_ADDRESS=mollae.pro, www.mollae.pro
# DB 비밀번호: 아무도 모르는 긴 문자열로(예: openssl rand -hex 24 결과).
DB_PASSWORD=
# 부장님 매매 판단(선택). 비우면 규칙으로 판단한다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# (선택) 되돌릴 때 이미지 태그(커밋 해시). 비우면 latest.
# IMAGE_TAG=
# (선택) 메모리가 넉넉한 서버면 게임 서버 메모리를 늘린다. 비우면 1GB 서버용 기본값.
# JAVA_OPTS=-Xmx1g
